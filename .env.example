# Public origin used in canonical URLs, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production owner authentication. Generate the hash with:
# npm run auth:hash -- "your-long-login-password"
OWNER_LOGIN=replace-with-owner-login
OWNER_PASSWORD_HASH=600000$replace-with-base64url-salt$replace-with-base64url-hash

# Optional RFC 6238 TOTP secret (Base32). When set, 2FA is mandatory at login.
OWNER_TOTP_SECRET=

# Server login session lifetime. The unlocked vault still locks after 5 minutes.
SESSION_TTL_MINUTES=480

# Giscus comments (https://giscus.app). Create a public repo with Discussions
# enabled, install the giscus app, then copy the four values from
# giscus.app's configuration wizard. Leave empty to show a placeholder.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
