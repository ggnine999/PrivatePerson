{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "audio:generate": "node scripts/generate-demo-audio.mjs",
    "account:clear-local": "node scripts/clear-local-accounts.mjs",
    "account:permission": "node scripts/set-account-permission.mjs",
    "build": "vinext build",
    "db:backup": "node scripts/backup-d1.mjs remote",
    "db:backup:local": "node scripts/backup-d1.mjs local",
    "db:generate": "node --require ./scripts/os-userinfo-shim.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --persist-to .wrangler/state --config wrangler.jsonc",
    "format": "oxfmt",
    "lint": "oxlint",
    "mascots:sync": "node scripts/generate-mascot-manifest.mjs",
    "prebuild": "npm run mascots:sync",
    "predev": "npm run mascots:sync",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "highlight.js": "^11.11.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "marked": "^16.3.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "3.2.7",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "overrides": {
    "undici": "7.29.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.4"
    }
  }
}
